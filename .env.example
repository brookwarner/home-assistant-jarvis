# ─── Telegram ───────────────────────────────────────────────────────────────
# Create a bot via @BotFather, then message it and check logs for your chat ID
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Home Assistant ──────────────────────────────────────────────────────────
# HA URL (use 172.30.32.1:8123 inside HA OS, or localhost:8123 externally)
HA_URL=http://172.30.32.1:8123
# Long-lived access token: HA → Profile → Long-Lived Access Tokens
HA_TOKEN=your_long_lived_access_token_here

# ─── AI Providers ───────────────────────────────────────────────────────────
# Defaults bill Anthropic directly (no OpenRouter markup, reliable prompt caching),
# so ANTHROPIC_API_KEY is what you need. Set OPENROUTER_API_KEY only if you switch
# the model strings below back to openrouter/* (e.g. to use Groq/free fallbacks).
ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...   # Optional — only if routing models through OpenRouter
# GROQ_API_KEY=gsk_...           # Optional — triage/briefing fallback (OpenRouter models only)

# ─── Models ─────────────────────────────────────────────────────────────────
# Triage: cheap/fast model to classify incoming messages
TRIAGE_MODEL=anthropic/claude-haiku-4-5
# Briefing: model for morning briefings
BRIEFING_MODEL=anthropic/claude-haiku-4-5
# Conversation: main chat model
CONVERSATION_MODEL=anthropic/claude-haiku-4-5
# Proactive: unattended polling — Haiku keeps background cost low (Sonnet is ~10x pricier)
PROACTIVE_MODEL=anthropic/claude-haiku-4-5
# Opus: sub-agent for complex tasks (delegated by conversation model)
OPUS_MODEL=anthropic/claude-opus-4-6

# ─── Identity ────────────────────────────────────────────────────────────────
# Name your AI assistant calls itself
BOT_NAME=Jarvis

# ─── Service ─────────────────────────────────────────────────────────────────
WEBHOOK_PORT=8765
LOG_LEVEL=INFO
# Your local timezone (used in system prompts so Jarvis converts times correctly)
# Find yours at: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Pacific/Auckland

# ─── Optional: Caravan auto-heat ─────────────────────────────────────────────
# The morning briefing asks whether you'll use the caravan that day. Reply yes and
# Jarvis enables the entities below (master toggle + auto-heat automation + heartbeats),
# each switched by its own domain. Reply no — or don't reply by CARAVAN_SAFETY_HOUR — and
# the auto-heat is forced off so an unused caravan never heats.
# CARAVAN_PROMPT_ENABLED=true
# Comma-separated entity_ids to toggle (mix of input_boolean / automation / switch ...)
# CARAVAN_ENTITIES=input_boolean.caravan_heater_enabled,automation.warm_caravan_on_cold_workdays
# Physical heater plugs the automation switches on. These are force-switched OFF whenever
# caravan heating is disabled (or you say you're done in the caravan), so a running heater
# actually stops — they are NOT turned on when enabling (the thermostat automation owns that).
# CARAVAN_HEATER_SWITCHES=switch.zigbee_plug_1_office,switch.tz3000_typdpbpg_ts011f_2
# Local hour (0-23) for the default-off safety net
# CARAVAN_SAFETY_HOUR=9

# ─── Optional: Voice ─────────────────────────────────────────────────────────
# Requires faster-whisper (not available on ARM/musllinux — install manually)
# WHISPER_MODEL=base   # tiny | base | small
